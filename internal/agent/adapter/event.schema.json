{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DavidW475/ade/internal/agent/adapter/event.schema.json",
  "title": "ADE event",
  "description": "An event of an agent session. All adapters produce this format; the UI only knows this one. See doc/architecture.md#event-schema.",
  "type": "object",
  "required": ["seq", "session_id", "ts", "type", "payload"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1, "description": "Consecutive per session, from 1, without gaps." },
    "session_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "description": "More types come with later milestones (approval_request, approval_decision, egress, …); clients show unknown types generically."
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "status" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "enum": ["starting", "running", "idle", "done", "failed", "stopped", "interrupted", "paused"] },
              "reason": { "type": "string" },
              "exit_code": { "type": "integer" },
              "model": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "message" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["role", "text"],
            "properties": {
              "role": { "enum": ["user", "assistant"] },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "thinking" } } },
      "then": {
        "properties": {
          "payload": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool_call" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["id", "tool"],
            "properties": {
              "id": { "type": "string" },
              "tool": { "type": "string" },
              "input": { "description": "Input of the tool as delivered by the CLI." },
              "parent_id": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool_result" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["id", "output"],
            "properties": {
              "id": { "type": "string", "description": "ID of the matching tool_call." },
              "output": { "type": "string" },
              "is_error": { "type": "boolean" },
              "truncated": { "type": "boolean" },
              "parent_id": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "cost" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["turn_usd", "total_usd"],
            "properties": {
              "turn_usd": { "type": "number" },
              "total_usd": { "type": "number" },
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "cache_read_tokens": { "type": "integer" },
              "cache_write_tokens": { "type": "integer" },
              "duration_ms": { "type": "integer" },
              "turns": { "type": "integer" },
              "model": { "type": "string" },
              "estimated": { "type": "boolean", "description": "The CLI reports no USD; ADE computed them from tokens and the price table." },
              "metered": { "type": "boolean", "description": "turn_usd is the sum measured by the egress proxy since the last turn." },
              "budget_usd": { "type": "number", "description": "Budget of the session (missing: none)." }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "usage" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "Usage of an API request measured by the egress proxy (M8); created by the manager, the timeline does not show it.",
            "required": ["input_tokens", "output_tokens", "cost_usd", "priced", "total_usd"],
            "properties": {
              "provider": { "type": "string" },
              "model": { "type": "string" },
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "cache_read_tokens": { "type": "integer" },
              "cache_write_tokens": { "type": "integer" },
              "cost_usd": { "type": "number" },
              "priced": { "type": "boolean" },
              "total_usd": { "type": "number" },
              "budget_usd": { "type": "number" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": {
        "properties": {
          "payload": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } } }
        }
      }
    }
  ]
}
